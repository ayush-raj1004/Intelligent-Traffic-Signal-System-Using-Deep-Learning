{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Server",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/server.ts",
            "runtimeExecutable": "npx",
            "runtimeArgs": [
                "tsx"
            ],
            "envFile": "${workspaceFolder}/.env"
        }
    ]
}
